# Copie ce fichier en .env pour tester en local :
#   cp .env.example .env
# puis lance :  node --env-file=.env server/index.js
#
# En production (Dokploy), ne crée PAS de .env : mets ces variables
# directement dans l'onglet Environment de l'application.

# --- Connexion par email (SMTP) ---------------------------------
# Exemple Gmail (avec un "mot de passe d'application", voir README) :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=birostt@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx        # mot de passe d'application (16 caractères, sans espaces)
SMTP_FROM='Budget <birostt@gmail.com>'

# --- Vraie connexion bancaire (optionnel) -----------------------
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=

# --- Divers -----------------------------------------------------
# PORT=3000
# DATA_DIR=./data
